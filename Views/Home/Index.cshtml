@{
    ViewData["Title"] = "Trang chủ";
    bool isAdminOrStaff = User.IsInRole("Admin") || User.IsInRole("Staff");
    bool isStudent = User.IsInRole("Student");
}

<div class="space-y-8">
    <div class="text-center py-8">
        <h1 class="text-5xl sm:text-6xl font-black font-['Nunito'] gradient-text mb-4">
            Hệ thống Quản lý Sinh viên
        </h1>
        <p class="text-xl text-[#635F69] font-medium max-w-2xl mx-auto leading-relaxed">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>Chào mừng, <span class="text-[#7C3AED] font-bold">@(User.FindFirst("FullName")?.Value ?? "bạn")</span>!</text>
            }
            else
            {
                <text>Hệ thống quản lý hồ sơ người học và quá trình theo học an toàn, bảo mật và hiện đại.</text>
            }
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto items-stretch">
        @if (isAdminOrStaff)
        {
            <a asp-controller="SinhVien" asp-action="Index"
               class="clay-card home-action-card hover-lift group cursor-pointer no-underline">
                <div class="flex h-full flex-col items-center justify-center text-center">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#A78BFA] to-[#7C3AED] flex items-center justify-center shadow-clay-button mb-4 group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-black font-['Nunito'] text-[#332F3A] mb-2">Quản lý Sinh viên</h3>
                    <p class="text-[#635F69] font-medium">Tiếp nhận hồ sơ, cấp mã sinh viên và cập nhật trạng thái theo học.</p>
                </div>
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index"
                   class="clay-card home-action-card hover-lift group cursor-pointer border-l-4 border-l-[#F59E0B] no-underline">
                    <div class="flex h-full flex-col items-center justify-center text-center">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#FBBF24] to-[#F59E0B] flex items-center justify-center shadow-clay-button mb-4 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656-.126-1.283-.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        </div>
                        <h3 class="text-2xl font-black font-['Nunito'] text-[#332F3A] mb-2">Quản lý Nhân viên</h3>
                        <p class="text-[#635F69] font-medium">Tạo tài khoản và phân quyền cho nhân viên đào tạo.</p>
                    </div>
                </a>
            }
            else
            {
                <a asp-controller="SinhVien" asp-action="Create"
                   class="clay-card home-action-card hover-lift group cursor-pointer border-l-4 border-l-[#0EA5E9] no-underline">
                    <div class="flex h-full flex-col items-center justify-center text-center">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#38BDF8] to-[#0EA5E9] flex items-center justify-center shadow-clay-button mb-4 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        </div>
                        <h3 class="text-2xl font-black font-['Nunito'] text-[#332F3A] mb-2">Tiếp nhận hồ sơ</h3>
                        <p class="text-[#635F69] font-medium">Tạo hồ sơ mới và cấp mã sinh viên tự động.</p>
                    </div>
                </a>
            }

            <a asp-controller="M03" asp-action="Index"
               class="clay-card home-action-card hover-lift group cursor-pointer border-l-4 border-l-[#8B5CF6] no-underline">
                <div class="flex h-full flex-col items-center justify-center text-center">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#C084FC] to-[#8B5CF6] flex items-center justify-center shadow-clay-button mb-4 group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332 5.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18 18.247 18 16.5 18c-1.746 0-3.332 5.477-4.5 1.253"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-black font-['Nunito'] text-[#332F3A] mb-2">M03 Theo học</h3>
                    <p class="text-[#635F69] font-medium">Quản lý chương trình đào tạo và quá trình theo học của sinh viên.</p>
                </div>
            </a>
        }
        else if (isStudent)
        {
            <a asp-controller="Student" asp-action="Profile"
               class="md:col-span-2 clay-card home-action-card hover-lift group cursor-pointer border-l-4 border-l-[#10B981] no-underline">
                <div class="flex min-h-56 flex-col items-center justify-center text-center">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#34D399] to-[#10B981] flex items-center justify-center shadow-clay-button mb-4">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7-7h14a7 7 0 00-7 7z"></path></svg>
                    </div>
                    <h3 class="text-3xl font-black font-['Nunito'] text-[#332F3A] mb-2">Hồ sơ của tôi</h3>
                    <p class="text-lg text-[#635F69] font-medium">Xem thông tin cá nhân và trạng thái học tập.</p>
                </div>
            </a>
        }
        else
        {
            <div class="md:col-span-2 text-center">
                <a asp-controller="Account" asp-action="Login" class="clay-btn clay-btn-primary text-lg px-8 active-press">Đăng nhập để truy cập hệ thống</a>
            </div>
        }
    </div>
</div>
