@model Secure_Academic_Management.ViewModels.M03DashboardViewModel
@{
    ViewData["Title"] = "Chương trình và lần theo học";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-[#332F3A]">Quản lý chương trình đào tạo và quá trình học tập</h1>
     
        </div>
        <div class="flex gap-3">
            <a asp-action="CreateProgram" class="clay-btn clay-btn-secondary">Thêm chương trình</a>
            <a asp-action="CreateEnrollment" class="clay-btn clay-btn-primary">Ghi nhận lần theo học</a>
            <a asp-action="CreateReference" class="clay-btn clay-btn-secondary">Thêm liên kết</a>
        </div>
    </div>

    <div class="clay-card p-6">
        <h2 class="text-xl font-black mb-4">Chương trình đào tạo</h2>
        <div class="overflow-x-auto">
            <table class="clay-table">
                <thead><tr><th>Mã</th><th>Tên chương trình</th><th>Trình độ</th><th>Đơn vị</th><th>Tuyển sinh</th></tr></thead>
                <tbody>
                @foreach (var program in Model.ChuongTrinhs)
                {
                    <tr><td class="font-bold text-[#7C3AED]">@program.MaChuongTrinh</td><td>@program.TenChuongTrinh</td><td>@program.TrinhDo</td><td>@program.DonViQuanLy</td><td>@(program.DangTuyenSinh ? "Có" : "Không")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="clay-card p-6">
        <h2 class="text-xl font-black mb-4">Lần theo học gần đây</h2>
        <div class="overflow-x-auto">
            <table class="clay-table">
                <thead><tr><th>Sinh viên</th><th>Chương trình</th><th>Khóa</th><th>Bắt đầu</th><th>Trạng thái</th><th>Chính quy</th></tr></thead>
                <tbody>
                @foreach (var enrollment in Model.LanTheoHocs)
                {
                    <tr><td>@enrollment.MaSinhVien - @enrollment.SinhVien.HoTen</td><td>@enrollment.MaChuongTrinh - @enrollment.ChuongTrinh.TenChuongTrinh</td><td>@enrollment.KhoaNhapHoc</td><td>@enrollment.NgayBatDau.ToString("dd/MM/yyyy")</td><td>@enrollment.TrangThai</td><td>@(enrollment.LaChuongTrinhChinh ? "Có" : "Không")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
