@model Secure_Academic_Management.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="flex items-center justify-center min-h-[65vh] py-8">
    <div class="w-full max-w-xl clay-card p-8">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-black font-['Nunito']">Đổi mật khẩu</h1>
            <p class="text-[#635F69] mt-2">Nhập mật khẩu hiện tại để bảo vệ tài khoản.</p>
        </div>
        <form asp-action="ChangePassword" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="clay-alert clay-alert-danger" role="alert"></div>
            <div>
                <label asp-for="CurrentPassword" class="block text-base font-bold mb-2"></label>
                <input asp-for="CurrentPassword" class="clay-input w-full" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-red-500 text-sm"></span>
            </div>
            <div>
                <label asp-for="NewPassword" class="block text-base font-bold mb-2"></label>
                <input asp-for="NewPassword" class="clay-input w-full" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-base font-bold mb-2"></label>
                <input asp-for="ConfirmPassword" class="clay-input w-full" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
            </div>
            <button type="submit" class="clay-btn clay-btn-primary w-full">Cập nhật mật khẩu</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
