@model Secure_Academic_Management.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="flex items-center justify-center min-h-[70vh]">
    <div class="w-full max-w-md clay-card p-8 sm:p-10 animate-clay-float">
        <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-[#A78BFA] to-[#7C3AED] flex items-center justify-center shadow-clay-button mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
            </div>
            <h1 class="text-3xl font-black font-['Nunito'] text-[#332F3A]">Chào mừng trở lại</h1>
            <p class="text-[#635F69] mt-2 font-medium">Đăng nhập để quản lý hồ sơ sinh viên</p>
        </div>

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-clay-md text-sm font-medium" role="alert"></div>
            
            <div>
                <label asp-for="Email" class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Email đăng nhập</label>
                <input asp-for="Email" class="clay-input w-full" placeholder="admin@university.edu.vn" autocomplete="email" />
                <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block ml-1"></span>
            </div>
            
            <div>
                <label asp-for="Password" class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Mật khẩu</label>
                <input asp-for="Password" class="clay-input w-full" placeholder="••••••••" type="password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block ml-1"></span>
            </div>
            
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <input asp-for="RememberMe" class="w-5 h-5 rounded-lg border-2 border-[#7C3AED] text-[#7C3AED] focus:ring-[#7C3AED] focus:ring-offset-0 cursor-pointer" />
                    <label asp-for="RememberMe" class="ml-2 text-sm font-medium text-[#635F69] cursor-pointer select-none">Ghi nhớ đăng nhập</label>
                </div>
            </div>
            
            <div class="space-y-3">
                <button type="submit" class="clay-btn clay-btn-primary w-full text-lg active-press">
                    Đăng nhập ngay
                </button>
                
                <a asp-action="Register" class="clay-btn clay-btn-secondary w-full text-lg active-press block text-center">
                    Đăng ký tài khoản mới
                </a>
            </div>
        </form>

        <div class="mt-6 text-center">
            <p class="text-sm text-[#635F69]">
                Demo tài khoản: <span class="font-bold text-[#7C3AED]">admin@university.edu.vn</span> / <span class="font-bold text-[#7C3AED]">Admin@123</span>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}