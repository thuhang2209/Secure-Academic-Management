@model Secure_Academic_Management.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký tài khoản mới";
}

<div class="flex items-center justify-center min-h-[70vh] py-12">
    <div class="w-full max-w-md clay-card p-8 sm:p-10 animate-clay-float">
        <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-[#34D399] to-[#10B981] flex items-center justify-center shadow-clay-button mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                </svg>
            </div>
            <h1 class="text-3xl font-black font-['Nunito'] text-[#332F3A]">Tạo tài khoản mới</h1>
            <p class="text-[#635F69] mt-2 font-medium">Đăng ký để bắt đầu sử dụng hệ thống</p>
        </div>

        <form asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-clay-md text-sm font-medium" role="alert"></div>
            
            <!-- Full Name -->
            <div>
                <label asp-for="FullName" class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Họ và tên</label>
                <input asp-for="FullName" class="clay-input w-full" placeholder="Nguyễn Văn A" />
                <span asp-validation-for="FullName" class="text-red-500 text-sm mt-1 block ml-1"></span>
            </div>

            <!-- Email -->
            <div>
                <label asp-for="Email" class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Email</label>
                <input asp-for="Email" class="clay-input w-full" placeholder="your.email@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block ml-1"></span>
            </div>

            <!-- Phone Number -->
            <div>
                <label asp-for="PhoneNumber" class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Số điện thoại</label>
                <input asp-for="PhoneNumber" class="clay-input w-full" placeholder="09xxxxxxxx" />
                <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm mt-1 block ml-1"></span>
            </div>

            <!-- Password -->
            <div>
                <label asp-for="Password" class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Mật khẩu</label>
                <input asp-for="Password" class="clay-input w-full" placeholder="••••••••" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block ml-1"></span>
                <p class="text-xs text-[#635F69] mt-1 ml-1">Tối thiểu 8 ký tự</p>
            </div>

            <!-- Confirm Password -->
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Xác nhận mật khẩu</label>
                <input asp-for="ConfirmPassword" class="clay-input w-full" placeholder="••••••••" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm mt-1 block ml-1"></span>
            </div>

            <!-- Submit & Login Buttons -->
            <div class="space-y-3 pt-4">
                <button type="submit" class="clay-btn clay-btn-primary w-full text-lg active-press">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                    </svg>
                    Đăng ký ngay
                </button>
                
                <a asp-action="Login" class="clay-btn clay-btn-secondary w-full text-lg active-press block text-center">
                    Đã có tài khoản? Đăng nhập
                </a>
            </div>
        </form>

        <div class="mt-6 text-center">
            <p class="text-xs text-[#635F69]">
                Bằng việc đăng ký, bạn đồng ý với 
                <a href="#" class="text-[#7C3AED] hover:underline font-medium">Điều khoản sử dụng</a>
                và 
                <a href="#" class="text-[#7C3AED] hover:underline font-medium">Chính sách bảo mật</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}