@model Secure_Academic_Management.ViewModels.CourseListViewModel
@{
    ViewData["Title"] = "Học phần";
}

<div class="clay-card p-6 space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-black">Danh mục học phần</h1>
            <p class="text-[#635F69]">Quản lý học phần dùng cho nhập kết quả học tập.</p>
        </div>
        <a asp-action="CreateCourse" class="clay-btn clay-btn-primary">Thêm học phần</a>
    </div>
    <form method="get" class="flex gap-2">
        <input name="search" value="@Model.Search" class="clay-input flex-1" placeholder="Tìm mã hoặc tên học phần" />
        <button class="clay-btn clay-btn-secondary" type="submit">Tìm</button>
    </form>
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead><tr><th class="p-3">Mã</th><th class="p-3">Tên học phần</th><th class="p-3">Tín chỉ</th></tr></thead>
            <tbody>
            @foreach (var course in Model.Courses)
            {
                <tr class="border-t border-slate-200"><td class="p-3 font-bold">@course.MaHocPhan</td><td class="p-3">@course.TenHocPhan</td><td class="p-3">@course.SoTinChi</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
