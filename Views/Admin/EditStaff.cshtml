@model Secure_Academic_Management.ViewModels.StaffEditViewModel

@{
    ViewData["Title"] = "Cập nhật nhân viên";
}

<div class="max-w-2xl mx-auto clay-card p-8">
    <h1 class="text-3xl font-black font-['Nunito'] mb-6">Cập nhật nhân viên</h1>
    <div asp-validation-summary="ModelOnly" class="text-[#B91C1C] mb-4"></div>
    <form asp-action="EditStaff" method="post" class="space-y-5">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div><label asp-for="FullName" class="block font-bold mb-2"></label><input asp-for="FullName" class="clay-input w-full" /><span asp-validation-for="FullName" class="text-[#B91C1C]"></span></div>
        <div><label asp-for="Email" class="block font-bold mb-2"></label><input asp-for="Email" class="clay-input w-full" /><span asp-validation-for="Email" class="text-[#B91C1C]"></span></div>
        <label class="flex items-center gap-2"><input asp-for="IsLocked" /> Khóa tài khoản nhân viên</label>
        <div class="flex gap-3"><button type="submit" class="clay-btn clay-btn-primary">Lưu thay đổi</button><a asp-action="Index" class="clay-btn clay-btn-secondary">Hủy</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
