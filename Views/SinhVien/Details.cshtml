@model Secure_Academic_Management.Models.SinhVien

@{
    ViewData["Title"] = "Chi tiết hồ sơ sinh viên";
}

<div class="max-w-6xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-4">
        <a asp-action="Index" class="w-10 h-10 rounded-xl bg-white flex items-center justify-center shadow-clay-button hover:-translate-y-1 transition-transform text-[#635F69] hover:text-[#7C3AED]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h1 class="text-3xl font-black font-['Nunito'] text-[#332F3A]">Chi tiết hồ sơ sinh viên</h1>
            <p class="text-[#635F69] font-medium">Mã sinh viên: <span class="text-[#7C3AED] font-bold">@Model.MaSinhVien</span></p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Cột trái: Thông tin cá nhân -->
        <div class="lg:col-span-2 clay-card p-8">
            <h2 class="text-xl font-black font-['Nunito'] text-[#332F3A] mb-6 flex items-center gap-2">
                <svg class="w-5 h-5 text-[#7C3AED]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                Thông tin cá nhân
            </h2>

            <div class="space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Họ và tên</label>
                        <div class="clay-input w-full bg-[#F4F1FA] cursor-default">
                            @Model.HoTen
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Email</label>
                        <div class="clay-input w-full bg-[#F4F1FA] cursor-default">
                            @Model.Email
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Số điện thoại</label>
                        <div class="clay-input w-full bg-[#F4F1FA] cursor-default">
                            @(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)
                        </div>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Ngày sinh</label>
                        <div class="clay-input w-full bg-[#F4F1FA] cursor-default">
                            @Model.NgaySinh.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Tuổi</label>
                        <div class="clay-input w-full bg-[#F4F1FA] cursor-default font-bold text-[#7C3AED]">
                            @{
                                var age = DateTime.Now.Year - Model.NgaySinh.Year;
                                if (Model.NgaySinh.Date > DateTime.Now.AddYears(-age)) age--;
                            }
                            @age tuổi
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-[#635F69] mb-2 ml-1">Ngày cập nhật</label>
                        <div class="clay-input w-full bg-[#F4F1FA] cursor-default text-sm">
                            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-8 flex gap-4">
                <a asp-action="Edit" asp-route-id="@Model.MaSinhVien" class="clay-btn clay-btn-primary flex-1 active-press">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    Chỉnh sửa
                </a>
                <a asp-action="Index" class="clay-btn clay-btn-secondary flex-1 text-center">
                    <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2"></path></svg>
                    Quay lại danh sách
                </a>
            </div>
        </div>

        <!-- Cột phải: Trạng thái & Cập nhật -->
        <div class="space-y-6">
            <!-- Card Trạng thái -->
            <div class="clay-card p-6 border-l-4 border-l-[#10B981]">
                <h2 class="text-lg font-black font-['Nunito'] text-[#332F3A] mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#10B981]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Trạng thái hiện tại
                </h2>

                <div class="bg-gradient-to-br from-[#F4F1FA] to-white rounded-clay-md p-5 mb-4 text-center shadow-clay-pressed">
                    <span class="text-sm text-[#635F69] font-medium block mb-2">Trạng thái đang áp dụng</span>
                    <span class="text-2xl font-black font-['Nunito'] text-[#7C3AED] block">@Model.TrangThai</span>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-clay-md p-4 mb-4">
                    <p class="text-xs text-blue-800 font-medium flex items-start gap-2">
                        <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>Mọi thay đổi trạng thái đều được ghi nhận và lưu vào nhật ký kiểm toán (Audit).</span>
                    </p>
                </div>

                @if (!string.Equals(Model.TrangThai, "Đang học", StringComparison.OrdinalIgnoreCase))
                {
                    var attachedFiles = Model.LichSuTrangThais
                        .Where(history => !string.IsNullOrWhiteSpace(history.DuongDanFile))
                        .ToList();

                    <div class="bg-amber-50 border border-amber-200 rounded-clay-md p-4 mb-4">
                        <h3 class="text-sm font-black text-amber-900 mb-3">Tệp liên quan đến trạng thái</h3>
                        @if (attachedFiles.Count == 0)
                        {
                            <p class="text-xs text-amber-800">Chưa có tệp đính kèm cho các lần thay đổi trạng thái.</p>
                        }
                        else
                        {
                            <div class="space-y-3">
                                @foreach (var history in attachedFiles)
                                {
                                    <div class="border-b border-amber-200 last:border-0 pb-3 last:pb-0">
                                        <a href="@history.DuongDanFile" target="_blank" rel="noopener noreferrer"
                                           class="text-sm font-bold text-amber-900 hover:underline break-words">
                                            @(history.TenFileGoc ?? "Mở tệp đính kèm")
                                        </a>
                                        <p class="text-xs text-amber-800 mt-1">
                                            @history.TrangThaiCu → @history.TrangThaiMoi ·
                                            @history.NgayThayDoi.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Nút Cập nhật Trạng thái -->
                <a asp-action="UpdateStatus" asp-route-id="@Model.MaSinhVien" class="clay-btn clay-btn-primary w-full active-press bg-gradient-to-br from-[#FBBF24] to-[#F59E0B] hover:from-[#F59E0B] hover:to-[#D97706]">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    Cập nhật Trạng thái
                </a>
            </div>

            <!-- Card Thông tin nhanh -->
            <div class="clay-card p-6">
                <h2 class="text-lg font-black font-['Nunito'] text-[#332F3A] mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#F59E0B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Thông tin nhanh
                </h2>

                <div class="space-y-3 text-sm">
                    <div class="flex justify-between items-center py-2 border-b border-[#F4F1FA]">
                        <span class="text-[#635F69] font-medium">Mã SV</span>
                        <span class="font-bold text-[#7C3AED]">@Model.MaSinhVien</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-[#F4F1FA]">
                        <span class="text-[#635F69] font-medium">Email</span>
                        <span class="font-medium truncate max-w-[150px]">@Model.Email</span>
                    </div>
                    <div class="flex justify-between items-center py-2">
                        <span class="text-[#635F69] font-medium">Ngày sinh</span>
                        <span class="font-medium">@Model.NgaySinh.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>