<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Secure Academic Management</title>
    
    <!-- Preconnect to Google Fonts for better performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Load fonts with Vietnamese subset -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@40..128,400;40..128,500;40..128,700&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/claymorphism.css" />

    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            clay: {
                                canvas: '#F4F1FA',
                                foreground: '#332F3A',
                                muted: '#635F69',
                                accent: '#7C3AED',
                                'accent-alt': '#DB2777',
                                'card-bg': 'rgba(255, 255, 255, 0.85)',
                            }
                        },
                        borderRadius: {
                            'clay-sm': '20px',
                            'clay-md': '24px',
                            'clay-lg': '32px',
                            'clay-xl': '40px',
                            'clay-2xl': '48px',
                            'clay-3xl': '60px',
                        },
                        animation: {
                            'clay-float': 'clay-float 8s ease-in-out infinite',
                            'clay-float-alt': 'clay-float-alt 10s ease-in-out infinite',
                            'clay-breathe': 'clay-breathe 6s ease-in-out infinite',
                        },
                        keyframes: {
                            'clay-float': {
                                '0%, 100%': { transform: 'translateY(0) rotate(0deg)' },
                                '50%': { transform: 'translateY(-20px) rotate(2deg)' },
                            },
                            'clay-float-alt': {
                                '0%, 100%': { transform: 'translateY(0) rotate(0deg)' },
                                '50%': { transform: 'translateY(-15px) rotate(-2deg)' },
                            },
                            'clay-breathe': {
                                '0%, 100%': { transform: 'scale(1)' },
                                '50%': { transform: 'scale(1.02)' },
                            }
                        }
                    }
                }
            }
    </script>
</head>
<body class="bg-[#F4F1FA] text-[#332F3A] min-h-screen relative overflow-x-hidden">

    <!-- Background Blobs (Ambient Lighting) -->
    <div class="fixed inset-0 overflow-hidden -z-10 pointer-events-none">
        <div class="absolute h-[60vh] w-[60vh] rounded-full bg-[#8B5CF6]/10 blur-3xl -top-[10%] -left-[10%] animate-clay-float"></div>
        <div class="absolute h-[50vh] w-[50vh] rounded-full bg-[#EC4899]/10 blur-3xl -right-[10%] top-[20%] animate-clay-float-alt animation-delay-2000"></div>
        <div class="absolute h-[40vh] w-[40vh] rounded-full bg-[#0EA5E9]/10 blur-3xl left-[20%] bottom-[10%] animate-clay-float animation-delay-4000"></div>
    </div>

    <!-- Navigation -->
    <nav class="clay-nav mx-4 mt-4 mb-8">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
            <!-- Logo - Click về trang chủ -->
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#A78BFA] to-[#7C3AED] flex items-center justify-center shadow-clay-button group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </div>
                <h1 class="text-2xl font-black font-['Nunito'] bg-gradient-to-r from-[#332F3A] to-[#7C3AED] bg-clip-text text-transparent group-hover:opacity-80 transition-opacity">
                    Learning Management System
                </h1>
            </a>
        
            <!-- Logout Button (chỉ hiện khi đã đăng nhập) -->
           @if (User.Identity.IsAuthenticated)
            {
                <div class="flex items-center gap-3">
                    <!-- User Name Badge -->
                    <div class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-clay-md bg-gradient-to-r from-[#A78BFA]/10 to-[#7C3AED]/10 border border-[#7C3AED]/20">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#34D399] to-[#10B981] flex items-center justify-center shadow-clay-button">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                        </div>
                        <span class="font-['Nunito'] font-bold text-[#332F3A] text-sm">
                            @if (User.FindFirst("FullName")?.Value != null)
                            {
                                @User.FindFirst("FullName").Value
                            }
                            else if (User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value != null)
                            {
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Name).Value
                            }
                            else
                            {
                                @User.Identity.Name
                            }
                        </span>
                    </div>

                    <!-- Form Logout với Anti-Forgery Token -->
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="clay-btn clay-btn-secondary text-sm h-11 px-6 active-press" 
                                style="background: none; border: none; cursor: pointer; padding: 0;">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                                    </path>
                                </svg>
                                <span>Đăng xuất</span>
                            </div>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="clay-btn clay-btn-primary text-sm h-11 px-6 active-press">
                    Đăng nhập
                </a>
            }
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="mt-auto py-8 text-center text-[#635F69]">
        <div class="max-w-7xl mx-auto px-4">
            <p class="font-['Nunito'] font-bold">
                <!-- &copy; @DateTime.Now.Year - Module M03: Sinh viên và quá trình theo học -->
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>